class _PamMessage(ctypes.Structure):
    _fields_ = [("msg_style", ctypes.c_int), ("msg", ctypes.c_char_p)]


class _PamResponse(ctypes.Structure):
    _fields_ = [("resp", ctypes.c_char_p), ("resp_retcode", ctypes.c_int)]


_PAM_CONV_FUNC = ctypes.CFUNCTYPE(
    ctypes.c_int,
    ctypes.c_int,
    ctypes.POINTER(ctypes.POINTER(_PamMessage)),
    ctypes.POINTER(ctypes.POINTER(_PamResponse)),
    ctypes.c_void_p,
)


class _PamConv(ctypes.Structure):
    _fields_ = [("conv", _PAM_CONV_FUNC), ("appdata_ptr", ctypes.c_void_p)]


_libc.calloc.argtypes = [ctypes.c_size_t, ctypes.c_size_t]
_libc.calloc.restype = ctypes.c_void_p
_libc.strdup.argtypes = [ctypes.c_char_p]
_libc.strdup.restype = ctypes.c_void_p


def verify_pam_password(password: str, service: str = "cosmic-greeter") -> bool:
    pw_bytes = password.encode("utf-8")

    def conv_cb(num_msg, msg, resp, _appdata):
        arr = ctypes.cast(_libc.calloc(num_msg, ctypes.sizeof(_PamResponse)), ctypes.POINTER(_PamResponse))
        for i in range(num_msg):
            if msg[i].contents.msg_style in (1, 2):
                arr[i].resp = _libc.strdup(pw_bytes)
                arr[i].resp_retcode = 0
        resp[0] = arr
        return 0

    c_func = _PAM_CONV_FUNC(conv_cb)
    conv = _PamConv(c_func, None)
    pamh = ctypes.c_void_p()
    username = pwd.getpwuid(os.getuid()).pw_name.encode("utf-8")

    rc = _libpam.pam_start(service.encode("utf-8"), username, ctypes.byref(conv), ctypes.byref(pamh))
    if rc != 0:
        return False
    try:
        rc = _libpam.pam_authenticate(pamh, 0)
        if rc == 0:
            rc = _libpam.pam_acct_mgmt(pamh, 0)
        return rc == 0
    finally:
        _libpam.pam_end(pamh, rc)


def system_display_name() -> str:
    try:
        ent = pwd.getpwuid(os.getuid())
        return ent.pw_gecos.split(",")[0].strip() or ent.pw_name
    except Exception:
        return os.environ.get("USER", "")


def load_config() -> dict:
    cfg = {
        "wallpaper": DEFAULT_WALLPAPER,
        "display_name": system_display_name(),
        "placeholder": "Enter your password",
        "pam_service": "cosmic-greeter",
    }
    try:
        if os.path.exists(CONFIG_PATH):
            with open(CONFIG_PATH, "r", encoding="utf-8") as f:
                data = json.load(f)
            if isinstance(data, dict):
                cfg.update(data)
    except Exception:
        pass
    return cfg


def draw_text(
    c_ctx: int,
    x: float,
    y: float,
    text: str,
    font_desc: str,
    rgba: tuple[float, float, float, float],
    align: str = "left",
    width: float = -1,
    letter_spacing: int = 0,
    shadow: tuple[float, float, float] | None = (0.0, 2.0, 0.38),
    clip_rect: tuple[float, float, float, float] | None = None,
) -> tuple[int, int]:
    layout = _libpangocairo.pango_cairo_create_layout(c_ctx)
    desc = _libpango.pango_font_description_from_string(font_desc.encode("utf-8"))
    _libpango.pango_layout_set_font_description(layout, desc)
    _libpango.pango_font_description_free(desc)

    attrs = None
    if letter_spacing:
        attrs = _libpango.pango_attr_list_new()
        _libpango.pango_attr_list_insert(attrs, _libpango.pango_attr_letter_spacing_new(int(letter_spacing)))
        _libpango.pango_layout_set_attributes(layout, attrs)

    if width > 0:
        _libpango.pango_layout_set_width(layout, int(width * PANGO_SCALE))
    if align == "right":
        _libpango.pango_layout_set_alignment(layout, PANGO_ALIGN_RIGHT)
    elif align == "center":
        _libpango.pango_layout_set_alignment(layout, PANGO_ALIGN_CENTER)
    else:
        _libpango.pango_layout_set_alignment(layout, PANGO_ALIGN_LEFT)

    tb = text.encode("utf-8")
    _libpango.pango_layout_set_text(layout, tb, len(tb))

    pw = ctypes.c_int(0)
    ph = ctypes.c_int(0)
    _libpango.pango_layout_get_pixel_size(layout, ctypes.byref(pw), ctypes.byref(ph))

    if clip_rect is not None:
        _libcairo.cairo_save(c_ctx)
        _libcairo.cairo_rectangle(c_ctx, clip_rect[0], clip_rect[1], clip_rect[2], clip_rect[3])
        _libcairo.cairo_clip(c_ctx)

    if shadow is not None:
        dx, dy, sa = shadow
        _libcairo.cairo_set_source_rgba(c_ctx, 0.03, 0.04, 0.10, float(rgba[3]) * sa)
        _libcairo.cairo_move_to(c_ctx, float(x + dx), float(y + dy))
        _libpangocairo.pango_cairo_show_layout(c_ctx, layout)

    _libcairo.cairo_set_source_rgba(c_ctx, float(rgba[0]), float(rgba[1]), float(rgba[2]), float(rgba[3]))
    _libcairo.cairo_move_to(c_ctx, float(x), float(y))
    _libpangocairo.pango_cairo_show_layout(c_ctx, layout)

    if clip_rect is not None:
        _libcairo.cairo_restore(c_ctx)

    if attrs:
        _libpango.pango_attr_list_unref(attrs)
    _libgobject.g_object_unref(layout)
    return pw.value, ph.value


def measure_text(c_ctx: int, text: str, font_desc: str, letter_spacing: int = 0) -> tuple[int, int]:
    layout = _libpangocairo.pango_cairo_create_layout(c_ctx)
    desc = _libpango.pango_font_description_from_string(font_desc.encode("utf-8"))
    _libpango.pango_layout_set_font_description(layout, desc)
    _libpango.pango_font_description_free(desc)

    attrs = None
    if letter_spacing:
        attrs = _libpango.pango_attr_list_new()
        _libpango.pango_attr_list_insert(attrs, _libpango.pango_attr_letter_spacing_new(int(letter_spacing)))
        _libpango.pango_layout_set_attributes(layout, attrs)

    tb = text.encode("utf-8")
    _libpango.pango_layout_set_text(layout, tb, len(tb))
    pw = ctypes.c_int(0)
    ph = ctypes.c_int(0)
    _libpango.pango_layout_get_pixel_size(layout, ctypes.byref(pw), ctypes.byref(ph))
    if attrs:
        _libpango.pango_attr_list_unref(attrs)
    _libgobject.g_object_unref(layout)
    return pw.value, ph.value


def rounded_rect_path(ctx: cairo.Context, x: float, y: float, w: float, h: float, r: float) -> None:
    r = min(r, w / 2.0, h / 2.0)
    ctx.new_sub_path()
    ctx.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    ctx.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    ctx.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    ctx.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    ctx.close_path()


class WallpaperCache:
    def __init__(self):
        self._cache: dict[tuple[str, float, int, int], tuple[cairo.ImageSurface, bytearray]] = {}

    def get(self, path: str, w: int, h: int) -> tuple[cairo.ImageSurface, bytearray] | None:
        try:
            mtime = os.path.getmtime(path)
        except OSError:
            mtime = 0.0
        key = (path, mtime, w, h)
        if key in self._cache:
            return self._cache[key]
        try:
            im = Image.open(path).convert("RGB")
            iw, ih = im.size
            scale = max(w / iw, h / ih)
            nw, nh = int(round(iw * scale)), int(round(ih * scale))
            im = im.resize((nw, nh), Image.LANCZOS)
            left = (nw - w) // 2
            top = (nh - h) // 2
            im = im.crop((left, top, left + w, top + h))

            arr = np.asarray(im, dtype=np.uint8)
            bgra = np.empty((h, w, 4), dtype=np.uint8)
            bgra[:, :, 0] = arr[:, :, 2]
            bgra[:, :, 1] = arr[:, :, 1]
            bgra[:, :, 2] = arr[:, :, 0]
            bgra[:, :, 3] = 255

            buf = bytearray(bgra.tobytes())
            surf = cairo.ImageSurface.create_for_data(buf, cairo.FORMAT_ARGB32, w, h, w * 4)
            self._cache.clear()
            self._cache[key] = (surf, buf)
            return surf, buf
        except Exception:
            return None


def draw_pop_logo(ctx: cairo.Context, c_ctx: int, cx: float, y: float, s: float) -> None:
    """Draw centered 'Pop!_os' brand header matching the reference layout."""
    f1 = f"Fira Sans ExtraBold {26.5 * s:.1f}"
    f2 = f"Fira Sans Medium {26.5 * s:.1f}"
    w1, _h1 = measure_text(c_ctx, "Pop!", f1, letter_spacing=int(-400 * s))
    w2, _h2 = measure_text(c_ctx, "_os", f2, letter_spacing=0)
    total_w = w1 + w2
    x0 = cx - total_w / 2.0
    draw_text(
        c_ctx, x0, y, "Pop!", f1, (1.0, 1.0, 1.0, 0.98),
        align="left", letter_spacing=int(-400 * s), shadow=(0.0, 2.0 * s, 0.40)
    )
    draw_text(
        c_ctx, x0 + w1 + 1.0 * s, y, "_os", f2, (0.30, 0.66, 0.83, 0.98),
        align="left", letter_spacing=0, shadow=(0.0, 2.0 * s, 0.40)
    )


def draw_avatar(ctx: cairo.Context, cx: float, cy: float, r: float) -> None:
    # Subtle outer shadow
    ctx.set_source_rgba(0.03, 0.05, 0.12, 0.25)
    ctx.arc(cx, cy + 3, r + 2, 0, 2 * math.pi)
    ctx.fill()

    # Frosted circle fill
    ctx.set_source_rgba(0.95, 0.97, 1.0, 0.20)
    ctx.arc(cx, cy, r, 0, 2 * math.pi)
    ctx.fill()

    # Crisp white silhouette inside
    ctx.save()
    ctx.arc(cx, cy, r - 4.0, 0, 2 * math.pi)
    ctx.clip()
    ctx.set_source_rgba(1.0, 1.0, 1.0, 0.96)
    # Head
    ctx.arc(cx, cy - r * 0.18, r * 0.23, 0, 2 * math.pi)
    ctx.fill()
    # Shoulders
    ctx.arc(cx, cy + r * 0.68, r * 0.50, math.pi, 2 * math.pi)
    ctx.fill()
    ctx.restore()

    # Crisp white ring
    ctx.set_source_rgba(1.0, 1.0, 1.0, 0.72)
    ctx.set_line_width(max(1.3, r * 0.035))
    ctx.arc(cx, cy, r, 0, 2 * math.pi)
    ctx.stroke()


def draw_padlock_icon(ctx: cairo.Context, cx: float, cy: float, s: float) -> None:
    ctx.save()
    ctx.set_source_rgba(1.0, 1.0, 1.0, 0.86)
    ctx.set_line_width(1.6 * s)
    ctx.set_line_cap(cairo.LINE_CAP_ROUND)
    ctx.set_line_join(cairo.LINE_JOIN_ROUND)
    bw, bh = 13.0 * s, 10.0 * s
    bx, by = cx - bw / 2.0, cy - 1.5 * s
    rounded_rect_path(ctx, bx, by, bw, bh, 2.5 * s)
    ctx.stroke()
    # Shackle
    sr = 4.0 * s
    ctx.new_sub_path()
    ctx.arc(cx, by, sr, math.pi, 2 * math.pi)
    ctx.stroke()
    # Keyhole dot
    ctx.arc(cx, by + bh * 0.52, 1.3 * s, 0, 2 * math.pi)
    ctx.fill()
    ctx.restore()


def draw_eye_icon(ctx: cairo.Context, cx: float, cy: float, s: float, revealed: bool, hovered: bool) -> None:
    ctx.save()
    ctx.set_source_rgba(1.0, 1.0, 1.0, 0.98 if hovered else 0.84)
    ctx.set_line_width(1.6 * s)
    ctx.set_line_cap(cairo.LINE_CAP_ROUND)
    rx = 9.5 * s
    ry = 6.2 * s
    ctx.new_path()
    ctx.move_to(cx - rx, cy)
    ctx.curve_to(cx - rx * 0.45, cy - ry, cx + rx * 0.45, cy - ry, cx + rx, cy)
    ctx.curve_to(cx + rx * 0.45, cy + ry, cx - rx * 0.45, cy + ry, cx - rx, cy)
    ctx.stroke()
    ctx.arc(cx, cy, 2.7 * s, 0, 2 * math.pi)
    ctx.stroke()
    if revealed:
        ctx.move_to(cx - 8.0 * s, cy + 6.5 * s)
        ctx.line_to(cx + 8.0 * s, cy - 6.5 * s)
        ctx.stroke()
    ctx.restore()


def draw_arrow_icon(ctx: cairo.Context, cx: float, cy: float, s: float) -> None:
    ctx.save()
    ctx.set_source_rgba(1.0, 1.0, 1.0, 0.96)
    ctx.set_line_width(2.0 * s)
    ctx.set_line_cap(cairo.LINE_CAP_ROUND)
    ctx.set_line_join(cairo.LINE_JOIN_ROUND)
    ctx.move_to(cx - 6.5 * s, cy)
    ctx.line_to(cx + 6.5 * s, cy)
    ctx.move_to(cx + 1.5 * s, cy - 5.0 * s)
    ctx.line_to(cx + 6.5 * s, cy)
    ctx.line_to(cx + 1.5 * s, cy + 5.0 * s)
    ctx.stroke()
    ctx.restore()


def draw_wifi_icon(ctx: cairo.Context, cx: float, cy: float, s: float, connected: bool, hovered: bool) -> None:
    ctx.save()
    a = 1.0 if hovered else (0.92 if connected else 0.55)
    ctx.set_source_rgba(1.0, 1.0, 1.0, a)
    ctx.set_line_width(1.9 * s)
    ctx.set_line_cap(cairo.LINE_CAP_ROUND)
    base_y = cy + 6.5 * s
    for r in (4.8 * s, 8.8 * s, 12.8 * s):
        ctx.new_sub_path()
        ctx.arc(cx, base_y, r, -math.pi * 0.76, -math.pi * 0.24)
        ctx.stroke()
    ctx.arc(cx, base_y, 1.6 * s, 0, 2 * math.pi)
    ctx.fill()
    if not connected:
        ctx.set_source_rgba(1.0, 0.55, 0.55, 0.95)
        ctx.move_to(cx - 9 * s, cy + 6 * s)
        ctx.line_to(cx + 9 * s, cy - 7 * s)
        ctx.stroke()
    ctx.restore()


def draw_volume_icon(ctx: cairo.Context, cx: float, cy: float, s: float, muted: bool, hovered: bool) -> None:
    ctx.save()
    ctx.set_source_rgba(1.0, 1.0, 1.0, 1.0 if hovered else 0.92)
    ctx.set_line_width(1.8 * s)
    ctx.set_line_cap(cairo.LINE_CAP_ROUND)
    ctx.set_line_join(cairo.LINE_JOIN_ROUND)
    # Speaker body
    ctx.move_to(cx - 9.0 * s, cy - 3.2 * s)
    ctx.line_to(cx - 4.8 * s, cy - 3.2 * s)
    ctx.line_to(cx + 0.5 * s, cy - 7.5 * s)
    ctx.line_to(cx + 0.5 * s, cy + 7.5 * s)
    ctx.line_to(cx - 4.8 * s, cy + 3.2 * s)
    ctx.line_to(cx - 9.0 * s, cy + 3.2 * s)
    ctx.close_path()
    ctx.stroke()
    if muted:
        ctx.move_to(cx + 4.5 * s, cy - 3.5 * s)
        ctx.line_to(cx + 10.5 * s, cy + 3.5 * s)
        ctx.move_to(cx + 10.5 * s, cy - 3.5 * s)
        ctx.line_to(cx + 4.5 * s, cy + 3.5 * s)
        ctx.stroke()
    else:
        ctx.new_sub_path()
        ctx.arc(cx + 1.5 * s, cy, 4.5 * s, -0.75, 0.75)
        ctx.stroke()
        ctx.new_sub_path()
        ctx.arc(cx + 1.5 * s, cy, 8.2 * s, -0.82, 0.82)
        ctx.stroke()
    ctx.restore()


def draw_power_icon(ctx: cairo.Context, cx: float, cy: float, s: float, hovered: bool) -> None:
    ctx.save()
    ctx.set_source_rgba(1.0, 1.0, 1.0, 1.0 if hovered else 0.92)
    ctx.set_line_width(1.9 * s)
    ctx.set_line_cap(cairo.LINE_CAP_ROUND)
    ctx.new_sub_path()
    ctx.arc(cx, cy + 0.5 * s, 8.2 * s, -math.pi * 0.30, math.pi * 1.30)
    ctx.stroke()
    ctx.move_to(cx, cy - 9.2 * s)
    ctx.line_to(cx, cy - 1.2 * s)
    ctx.stroke()
    ctx.restore()


def compute_geometry(w: int, h: int) -> dict:
    s = min(w / 1920.0, h / 1080.0)
    cx = w / 2.0
    pill_w = 424.0 * s
    pill_h = 50.0 * s
    gap = 12.0 * s
    btn_d = 50.0 * s
    total_w = pill_w + gap + btn_d
    pill_x = cx - total_w / 2.0
    pill_y = 668.0 * s
    btn_cx = pill_x + pill_w + gap + btn_d / 2.0
    btn_cy = pill_y + pill_h / 2.0

    icon_y = h - 50.0 * s
    wifi_cx = w - 144.0 * s
    vol_cx = w - 98.0 * s
    pwr_cx = w - 52.0 * s

    menu_w = 186.0 * s
    menu_h = 126.0 * s
    menu_x = w - 28.0 * s - menu_w
    menu_y = icon_y - 28.0 * s - menu_h

    return {
        "s": s, "cx": cx,
        "logo_y": 86.0 * s,
        "clock_y": 164.0 * s,
        "date_y": 362.0 * s,
        "avatar_cy": 526.0 * s,
        "avatar_r": 52.0 * s,
        "name_y": 598.0 * s,
        "pill_x": pill_x, "pill_y": pill_y, "pill_w": pill_w, "pill_h": pill_h,
        "eye_cx": pill_x + pill_w - 26.0 * s, "eye_cy": pill_y + pill_h / 2.0,
        "btn_cx": btn_cx, "btn_cy": btn_cy, "btn_r": btn_d / 2.0,
        "icon_y": icon_y, "wifi_cx": wifi_cx, "vol_cx": vol_cx, "pwr_cx": pwr_cx,
        "menu_x": menu_x, "menu_y": menu_y, "menu_w": menu_w, "menu_h": menu_h,
    }


def render_lockscreen_frame(
    w: int,
    h: int,
    cfg: dict,
    wp_cache: WallpaperCache,
    now: datetime,
    password: str,
    show_password: bool,
    verifying: bool,
    error_msg: str,
    caps_lock: bool,
    cursor_on: bool,
    hover_target: str | None,
    wifi_info: tuple[bool, str],
    vol_info: tuple[bool, int],
    active_popover: str | None,
) -> bytes:
    buf = bytearray(w * h * 4)
    surface = cairo.ImageSurface.create_for_data(buf, cairo.FORMAT_ARGB32, w, h, w * 4)
    ctx = cairo.Context(surface)
    g = compute_geometry(w, h)
    s = g["s"]

    # Background wallpaper
    wp = wp_cache.get(cfg["wallpaper"], w, h)
    if wp is not None:
        wp_surf, _ = wp
        ctx.set_source_surface(wp_surf, 0, 0)
        ctx.paint()
    else:
        grad = cairo.LinearGradient(0, 0, 0, h)
        grad.add_color_stop_rgb(0.0, 0.06, 0.10, 0.22)
        grad.add_color_stop_rgb(1.0, 0.04, 0.06, 0.14)
        ctx.set_source(grad)
        ctx.paint()

    # Very subtle top & bottom readability vignette (preserves sunset clarity)
    vig_top = cairo.LinearGradient(0, 0, 0, h * 0.28)
    vig_top.add_color_stop_rgba(0.0, 0.02, 0.04, 0.10, 0.22)
    vig_top.add_color_stop_rgba(1.0, 0.02, 0.04, 0.10, 0.0)
    ctx.set_source(vig_top)
    ctx.paint()

    vig_bot = cairo.LinearGradient(0, h * 0.72, 0, h)
    vig_bot.add_color_stop_rgba(0.0, 0.02, 0.03, 0.08, 0.0)
    vig_bot.add_color_stop_rgba(1.0, 0.02, 0.03, 0.08, 0.28)
    ctx.set_source(vig_bot)
    ctx.paint()

    # Avatar & Glass Pill vectors (Cairo)
    draw_avatar(ctx, g["cx"], g["avatar_cy"], g["avatar_r"])

    # Password pill
    px, py, pw, ph = g["pill_x"], g["pill_y"], g["pill_w"], g["pill_h"]
    rounded_rect_path(ctx, px, py, pw, ph, ph / 2.0)
    ctx.set_source_rgba(0.07, 0.11, 0.20, 0.40 if not verifying else 0.52)
    ctx.fill_preserve()
    if error_msg:
        ctx.set_source_rgba(1.0, 0.45, 0.45, 0.92)
    elif len(password) > 0:
        ctx.set_source_rgba(1.0, 1.0, 1.0, 0.80)
    else:
        ctx.set_source_rgba(1.0, 1.0, 1.0, 0.56)
    ctx.set_line_width(1.3 * s)
    ctx.stroke()

    draw_padlock_icon(ctx, px + 24.0 * s, py + ph / 2.0, s)
    draw_eye_icon(ctx, g["eye_cx"], g["eye_cy"], s, show_password, hover_target == "eye")

    # Submit arrow circle button
    bcx, bcy, br = g["btn_cx"], g["btn_cy"], g["btn_r"]
    ctx.set_source_rgba(1.0, 1.0, 1.0, 0.38 if hover_target == "submit" else 0.24)
    ctx.arc(bcx, bcy, br, 0, 2 * math.pi)
    ctx.fill_preserve()
    ctx.set_source_rgba(1.0, 1.0, 1.0, 0.46)
    ctx.set_line_width(1.1 * s)
    ctx.stroke()
    draw_arrow_icon(ctx, bcx, bcy, s)

    # Bottom-right icons
    icon_s = s * 1.12
    draw_wifi_icon(ctx, g["wifi_cx"], g["icon_y"], icon_s, wifi_info[0], hover_target == "wifi")
    draw_volume_icon(ctx, g["vol_cx"], g["icon_y"], icon_s, vol_info[0], hover_target == "vol")
    draw_power_icon(ctx, g["pwr_cx"], g["icon_y"], icon_s, hover_target == "pwr")

    # Popovers if active
    if active_popover == "power":
        mx, my, mw, mh = g["menu_x"], g["menu_y"], g["menu_w"], g["menu_h"]
        rounded_rect_path(ctx, mx, my, mw, mh, 14.0 * s)
        ctx.set_source_rgba(0.08, 0.11, 0.20, 0.84)
        ctx.fill_preserve()
        ctx.set_source_rgba(1.0, 1.0, 1.0, 0.28)
        ctx.set_line_width(1.1 * s)
        ctx.stroke()
        row_h = mh / 3.0
        for idx, tag in enumerate(("pwr_sleep", "pwr_reboot", "pwr_off")):
            if hover_target == tag:
                rounded_rect_path(ctx, mx + 6 * s, my + idx * row_h + 4 * s, mw - 12 * s, row_h - 8 * s, 9.0 * s)
                ctx.set_source_rgba(1.0, 1.0, 1.0, 0.16)
                ctx.fill()
    elif active_popover in ("wifi", "vol"):
        box_w, box_h = 220.0 * s, 38.0 * s
        box_x = w - 28.0 * s - box_w
        box_y = g["icon_y"] - 26.0 * s - box_h
        rounded_rect_path(ctx, box_x, box_y, box_w, box_h, 12.0 * s)
        ctx.set_source_rgba(0.08, 0.11, 0.20, 0.82)
        ctx.fill_preserve()
        ctx.set_source_rgba(1.0, 1.0, 1.0, 0.28)
        ctx.set_line_width(1.1 * s)
        ctx.stroke()

    surface.flush()
    del ctx
    del surface

    # Pango text pass on same ARGB32 buffer
    raw_arr = (ctypes.c_uint8 * len(buf)).from_buffer(buf)
    c_surf = _libcairo.cairo_image_surface_create_for_data(raw_arr, 0, w, h, w * 4)
    c_ctx = _libcairo.cairo_create(c_surf)
    c_surf_helper_ctx = cairo.Context(cairo.ImageSurface.create_for_data(buf, cairo.FORMAT_ARGB32, w, h, w * 4))

    # Pop!_os logo
    draw_pop_logo(c_surf_helper_ctx, c_ctx, g["cx"], g["logo_y"], s)

    # Big clock
    time_str = now.strftime("%H:%M")
    draw_text(
        c_ctx, 0, g["clock_y"], time_str, f"Jost Medium {114.0 * s:.1f}",
        (1.0, 1.0, 1.0, 0.99), align="center", width=w,
        letter_spacing=int(1800 * s), shadow=(0.0, 4.0 * s, 0.34),
    )

    # Indonesian date
    date_str = f"{DAYS_ID[now.weekday()]}, {now.day} {MONTHS_ID[now.month - 1]} {now.year}"
    draw_text(
        c_ctx, 0, g["date_y"], date_str, f"Fira Sans {19.5 * s:.1f}",
        (1.0, 1.0, 1.0, 0.95), align="center", width=w,
        letter_spacing=int(200 * s), shadow=(0.0, 2.0 * s, 0.38),
    )

    # Display name
    draw_text(
        c_ctx, 0, g["name_y"], cfg.get("display_name") or system_display_name(), f"Fira Sans Medium {19.5 * s:.1f}",
        (1.0, 1.0, 1.0, 0.97), align="center", width=w,
        letter_spacing=0, shadow=(0.0, 2.0 * s, 0.42),
    )

    # Password field content
    tx_x = px + 48.0 * s
    tx_w = pw - 96.0 * s
    tx_clip = (tx_x, py + 4.0 * s, tx_w, ph - 8.0 * s)

    if len(password) == 0:
        ph_font = f"Fira Sans {13.8 * s:.1f}"
        _, th = measure_text(c_ctx, cfg["placeholder"], ph_font)
        draw_text(
            c_ctx, tx_x + 2.0 * s, py + (ph - th) / 2.0,
            cfg["placeholder"], ph_font, (1.0, 1.0, 1.0, 0.80),
            align="left", shadow=None, clip_rect=tx_clip,
        )
        if cursor_on and not verifying:
            _libcairo.cairo_set_source_rgba(c_ctx, 1.0, 1.0, 1.0, 0.90)
            c_surf_helper_ctx.set_source_rgba(1.0, 1.0, 1.0, 0.88)
            c_surf_helper_ctx.set_line_width(1.6 * s)
            c_surf_helper_ctx.move_to(tx_x + 1.0 * s, py + 13.0 * s)
            c_surf_helper_ctx.line_to(tx_x + 1.0 * s, py + ph - 13.0 * s)
            c_surf_helper_ctx.stroke()
    elif not show_password:
        dot_step = 13.0 * s
        max_dots = max(1, int((tx_w - 8.0 * s) / dot_step))
        n_dots = min(len(password), max_dots)
        c_surf_helper_ctx.set_source_rgba(1.0, 1.0, 1.0, 0.96)
        dot_y = py + ph / 2.0
        for i in range(n_dots):
            c_surf_helper_ctx.arc(tx_x + 5.0 * s + i * dot_step, dot_y, 3.8 * s, 0, 2 * math.pi)
            c_surf_helper_ctx.fill()
        if cursor_on and not verifying:
            cur_x = tx_x + 5.0 * s + n_dots * dot_step - 2.0 * s
            c_surf_helper_ctx.set_source_rgba(1.0, 1.0, 1.0, 0.92)
            c_surf_helper_ctx.set_line_width(1.6 * s)
            c_surf_helper_ctx.move_to(cur_x, py + 13.0 * s)
            c_surf_helper_ctx.line_to(cur_x, py + ph - 13.0 * s)
            c_surf_helper_ctx.stroke()
    else:
        pw_font = f"Fira Sans {13.5 * s:.1f}"
        pw_px, pw_py = measure_text(c_ctx, password, pw_font)
        draw_x = tx_x + min(0.0, tx_w - 6.0 * s - pw_px)
        draw_text(
            c_ctx, draw_x, py + (ph - pw_py) / 2.0,
            password, pw_font, (1.0, 1.0, 1.0, 0.96),
            align="left", shadow=None, clip_rect=tx_clip,
        )
        if cursor_on and not verifying:
            cur_x = min(tx_x + tx_w - 2.0 * s, draw_x + pw_px + 2.0 * s)
            c_surf_helper_ctx.set_source_rgba(1.0, 1.0, 1.0, 0.92)
            c_surf_helper_ctx.set_line_width(1.6 * s)
            c_surf_helper_ctx.move_to(cur_x, py + 13.0 * s)
            c_surf_helper_ctx.line_to(cur_x, py + ph - 13.0 * s)
            c_surf_helper_ctx.stroke()

    # Feedback line below pill
    msg = error_msg or ("Memeriksa password..." if verifying else ("Caps Lock aktif" if caps_lock else ""))
    if msg:
        col = (1.0, 0.58, 0.58, 0.98) if error_msg else (
            (0.86, 0.94, 1.0, 0.94) if verifying else (1.0, 0.86, 0.48, 0.96)
        )
        draw_text(
            c_ctx, 0, py + ph + 14.0 * s, msg, f"Fira Sans Medium {11.5 * s:.1f}",
            col, align="center", width=w, shadow=(0.0, 1.5 * s, 0.45),
        )

    # Popover texts
    if active_popover == "power":
        mx, my, mw, mh = g["menu_x"], g["menu_y"], g["menu_w"], g["menu_h"]
        row_h = mh / 3.0
        for idx, (label, col) in enumerate((
            ("Sleep (Tidur)", (0.96, 0.98, 1.0, 0.96)),
            ("Restart", (0.96, 0.98, 1.0, 0.96)),
            ("Shut Down", (1.0, 0.62, 0.62, 0.98)),
        )):
            draw_text(
                c_ctx, mx + 18.0 * s, my + idx * row_h + (row_h - 18.0 * s) / 2.0,
                label, f"Fira Sans Medium {11.5 * s:.1f}", col, align="left", shadow=None,
            )
    elif active_popover == "wifi":
        box_w, box_h = 220.0 * s, 38.0 * s
        box_x = w - 28.0 * s - box_w
        box_y = g["icon_y"] - 26.0 * s - box_h
        draw_text(
            c_ctx, box_x, box_y + 9.5 * s, wifi_info[1], f"Fira Sans Medium {11.0 * s:.1f}",
            (0.96, 0.98, 1.0, 0.96), align="center", width=box_w, shadow=None,
        )
    elif active_popover == "vol":
        box_w, box_h = 220.0 * s, 38.0 * s
        box_x = w - 28.0 * s - box_w
        box_y = g["icon_y"] - 26.0 * s - box_h
        v_txt = "Audio: Mute" if vol_info[0] else f"Volume: {vol_info[1]}%"
        draw_text(
            c_ctx, box_x, box_y + 9.5 * s, v_txt, f"Fira Sans Medium {11.0 * s:.1f}",
            (0.96, 0.98, 1.0, 0.96), align="center", width=box_w, shadow=None,
        )

    c_surf_helper_ctx.get_target().flush()
    del c_surf_helper_ctx
    _libcairo.cairo_surface_flush(c_surf)
    _libcairo.cairo_destroy(c_ctx)
    _libcairo.cairo_surface_destroy(c_surf)
    return bytes(buf)


def read_wifi_status() -> tuple[bool, str]:
    try:
        out = subprocess.check_output(
            ["nmcli", "-t", "-f", "ACTIVE,SSID,SIGNAL", "dev", "wifi"],
            stderr=subprocess.DEVNULL, timeout=1.5, text=True
        )
        for line in out.splitlines():
            parts = line.split(":")
            if len(parts) >= 3 and parts[0] == "yes":
                ssid = parts[1] or "Wi-Fi"
                sig = parts[2] or "?"
                return True, f"Wi-Fi: {ssid} ({sig}%)"
        return False, "Wi-Fi: Terputus"
    except Exception:
        return True, "Wi-Fi: Aktif"


def read_volume_status() -> tuple[bool, int]:
    try:
        out = subprocess.check_output(
            ["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"],
            stderr=subprocess.DEVNULL, timeout=1.5, text=True
        ).strip()
        muted = "[MUTED]" in out
        val = 100
        for tok in out.split():
            if tok.replace(".", "", 1).isdigit():
                val = int(round(float(tok) * 100))
                break
        return muted, val
    except Exception:
        return False, 100


class LockSessionController:
    def __init__(self, on_locked_cb=None, on_unlocked_cb=None):
        self.cfg = load_config()
        self.wp_cache = WallpaperCache()
        self.on_locked_cb = on_locked_cb
        self.on_unlocked_cb = on_unlocked_cb

        self._lock = threading.Lock()
        self.proc: subprocess.Popen | None = None
        self.outputs: dict[int, tuple[int, int]] = {}
        self.password = ""
        self.show_password = False
        self.verifying = False
        self.error_msg = ""
        self.error_until = 0.0
        self.caps_lock = False
        self.cursor_on = True
        self.hover_target: str | None = None
        self.active_popover: str | None = None
        self.popover_until = 0.0
        self.wifi_info = (True, "Wi-Fi")
        self.vol_info = (False, 100)
        self.locked_event = threading.Event()
        self._running = False

    def is_active(self) -> bool:
        return self.proc is not None and self.proc.poll() is None

    def start_lock(self, wait_locked_s: float = 0.0) -> bool:
        with self._lock:
            if self.is_active():
                return True
            self.outputs.clear()
            self.password = ""
            self.show_password = False
            self.verifying = False
            self.error_msg = ""
            self.error_until = 0.0
            self.caps_lock = False
            self.cursor_on = True
            self.hover_target = None
            self.active_popover = None
            self.locked_event.clear()
            self._running = True

            self.wifi_info = read_wifi_status()
            self.vol_info = read_volume_status()

            self.proc = subprocess.Popen(
                [HOST_BIN],
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                bufsize=0,
            )
            threading.Thread(target=self._reader_loop, daemon=True).start()
            threading.Thread(target=self._tick_loop, daemon=True).start()

        if wait_locked_s > 0:
            return self.locked_event.wait(timeout=wait_locked_s)
        return True

    def force_unlock(self) -> None:
        with self._lock:
            self.password = ""
            self._running = False
            if self.proc and self.proc.poll() is None and self.proc.stdin:
                try:
                    self.proc.stdin.write(b"UNLOCK\n")
                    self.proc.stdin.flush()
                except Exception:
                    pass

    def _send_frame(self, oid: int, w: int, h: int) -> None:
        if not self.proc or self.proc.poll() is not None or not self.proc.stdin:
            return
        now = datetime.now()
        err = self.error_msg if time.monotonic() < self.error_until else ""
        if self.active_popover in ("wifi", "vol") and time.monotonic() > self.popover_until:
            self.active_popover = None
        frame = render_lockscreen_frame(
            w, h, self.cfg, self.wp_cache, now,
            self.password, self.show_password, self.verifying,
            err, self.caps_lock, self.cursor_on, self.hover_target,
            self.wifi_info, self.vol_info, self.active_popover,
        )
        hdr = f"FRAME {oid} {len(frame)}\n".encode("ascii")
        try:
            self.proc.stdin.write(hdr + frame)
            self.proc.stdin.flush()
        except Exception:
            pass

    def _render_all_locked(self) -> None:
        for oid, (w, h) in list(self.outputs.items()):
            self._send_frame(oid, w, h)

    def _tick_loop(self) -> None:
        while self._running and self.is_active():
            time.sleep(0.55)
            with self._lock:
                if not self._running or not self.is_active():
                    break
                self.cursor_on = not self.cursor_on
                self._render_all_locked()

    def _submit_password(self) -> None:
        with self._lock:
            if self.verifying or not self.password:
                return
            pw = self.password
            svc = self.cfg.get("pam_service", "cosmic-greeter")
            self.verifying = True
            self.error_msg = ""
            self._render_all_locked()

        def worker():
            ok = False
            try:
                ok = verify_pam_password(pw, service=svc)
            except Exception:
                ok = False
            with self._lock:
                self.verifying = False
                if ok:
                    self.password = ""
                    self._running = False
                    if self.proc and self.proc.poll() is None and self.proc.stdin:
                        try:
                            self.proc.stdin.write(b"UNLOCK\n")
                            self.proc.stdin.flush()
                        except Exception:
                            pass
                else:
                    self.password = ""
                    self.error_msg = "Password salah, coba lagi"
                    self.error_until = time.monotonic() + 2.8
                    self._render_all_locked()

        threading.Thread(target=worker, daemon=True).start()

    def _hit_test(self, oid: int, x: float, y: float) -> str | None:
        if oid not in self.outputs:
            return None
        w, h = self.outputs[oid]
        g = compute_geometry(w, h)
        s = g["s"]

        if self.active_popover == "power":
            mx, my, mw, mh = g["menu_x"], g["menu_y"], g["menu_w"], g["menu_h"]
            if mx <= x <= mx + mw and my <= y <= my + mh:
                idx = int((y - my) / (mh / 3.0))
                return ("pwr_sleep", "pwr_reboot", "pwr_off")[min(2, max(0, idx))]

        if math.hypot(x - g["eye_cx"], y - g["eye_cy"]) <= 22.0 * s:
            return "eye"
        if math.hypot(x - g["btn_cx"], y - g["btn_cy"]) <= g["btn_r"] + 4.0 * s:
            return "submit"
        if math.hypot(x - g["wifi_cx"], y - g["icon_y"]) <= 20.0 * s:
            return "wifi"
        if math.hypot(x - g["vol_cx"], y - g["icon_y"]) <= 20.0 * s:
            return "vol"
        if math.hypot(x - g["pwr_cx"], y - g["icon_y"]) <= 20.0 * s:
            return "pwr"
        return None

    def _handle_click(self, oid: int, x: float, y: float, btn: int) -> None:
        if btn != BTN_LEFT:
            return
        with self._lock:
            hit = self._hit_test(oid, x, y)
            if hit == "eye":
                self.show_password = not self.show_password
            elif hit == "submit":
                pass
            elif hit == "wifi":
                self.wifi_info = read_wifi_status()
                self.active_popover = None if self.active_popover == "wifi" else "wifi"
                self.popover_until = time.monotonic() + 4.5
            elif hit == "vol":
                try:
                    subprocess.run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=1.5)
                except Exception:
                    pass
                self.vol_info = read_volume_status()
                self.active_popover = "vol"
                self.popover_until = time.monotonic() + 3.0
            elif hit == "pwr":
                self.active_popover = None if self.active_popover == "power" else "power"
            elif hit == "pwr_sleep":
                self.active_popover = None
                threading.Thread(target=lambda: subprocess.run(["systemctl", "suspend"]), daemon=True).start()
            elif hit == "pwr_reboot":
                self.active_popover = None
                threading.Thread(target=lambda: subprocess.run(["systemctl", "reboot"]), daemon=True).start()
            elif hit == "pwr_off":
                self.active_popover = None
                threading.Thread(target=lambda: subprocess.run(["systemctl", "poweroff"]), daemon=True).start()
            else:
                self.active_popover = None
            self._render_all_locked()

        if hit == "submit":
            self._submit_password()

    def _handle_key(self, sym: int, text: str) -> None:
        submit = False
        with self._lock:
            if self.verifying:
                return
            if sym in (XKB_KEY_Return, XKB_KEY_KP_Enter):
                submit = True
            elif sym == XKB_KEY_BackSpace:
                if self.password:
                    self.password = self.password[:-1]
            elif sym == XKB_KEY_Escape:
                self.password = ""
                self.active_popover = None
            elif sym == XKB_KEY_Tab:
                self.show_password = not self.show_password
            elif text and all(ord(ch) >= 32 and ord(ch) != 127 for ch in text):
                if len(self.password) < 256:
                    self.password += text
                    self.error_msg = ""
            self.cursor_on = True
            self._render_all_locked()
        if submit:
            self._submit_password()

    def _reader_loop(self) -> None:
        proc = self.proc
        if not proc or not proc.stdout:
            return
        try:
            for raw_line in iter(proc.stdout.readline, b""):
                line = raw_line.decode("utf-8", errors="ignore").strip()
                if not line:
                    continue
                parts = line.split()
                cmd = parts[0]
                if cmd == "OUTPUT" and len(parts) == 4:
                    oid, w, h = int(parts[1]), int(parts[2]), int(parts[3])
                    with self._lock:
                        self.outputs[oid] = (w, h)
                        self._send_frame(oid, w, h)
                elif cmd == "OUTPUT_REMOVED" and len(parts) == 2:
                    oid = int(parts[1])
                    with self._lock:
                        self.outputs.pop(oid, None)
                elif cmd == "LOCKED":
                    self.locked_event.set()
                    if self.on_locked_cb:
                        self.on_locked_cb()
                elif cmd == "CAPS" and len(parts) == 2:
                    with self._lock:
                        self.caps_lock = parts[1] == "1"
                        self._render_all_locked()
                elif cmd == "MOTION" and len(parts) == 4:
                    oid, x, y = int(parts[1]), float(parts[2]), float(parts[3])
                    with self._lock:
                        nh = self._hit_test(oid, x, y)
                        if nh != self.hover_target:
                            self.hover_target = nh
                            self._render_all_locked()
                elif cmd == "CLICK" and len(parts) == 5:
                    oid, x, y, btn = int(parts[1]), float(parts[2]), float(parts[3]), int(parts[4])
                    self._handle_click(oid, x, y, btn)
                elif cmd == "KEY" and len(parts) >= 2:
                    sym = int(parts[1], 16)
                    txt = bytes.fromhex(parts[2]).decode("utf-8", errors="ignore") if len(parts) >= 3 else ""
                    self._handle_key(sym, txt)
        except Exception:
            pass
        finally:
            try:
                proc.wait(timeout=2)
            except Exception:
                pass
            with self._lock:
                self._running = False
                self.password = ""
                if self.proc is proc:
                    self.proc = None
            if self.on_unlocked_cb:
                self.on_unlocked_cb()


def resolve_session_path(bus: Gio.DBusConnection) -> str:
    try:
        res = bus.call_sync(
            "org.freedesktop.login1", "/org/freedesktop/login1",
            "org.freedesktop.login1.Manager", "GetSessionByPID",
            GLib.Variant("(u)", (os.getpid(),)), None, Gio.DBusCallFlags.NONE, 2000, None
        )
        return res.unpack()[0]
    except Exception:
        pass

    sid = os.environ.get("XDG_SESSION_ID")
    if sid:
        try:
            res = bus.call_sync(
                "org.freedesktop.login1", "/org/freedesktop/login1",
                "org.freedesktop.login1.Manager", "GetSession",
                GLib.Variant("(s)", (sid,)), None, Gio.DBusCallFlags.NONE, 2000, None
            )
            return res.unpack()[0]
        except Exception:
            pass

    uid = os.getuid()
    try:
        ures = bus.call_sync(
            "org.freedesktop.login1", "/org/freedesktop/login1",
            "org.freedesktop.login1.Manager", "GetUser",
            GLib.Variant("(u)", (uid,)), None, Gio.DBusCallFlags.NONE, 2000, None
        )
        user_path = ures.unpack()[0]
        prop = bus.call_sync(
            "org.freedesktop.login1", user_path,
            "org.freedesktop.DBus.Properties", "Get",
            GLib.Variant("(ss)", ("org.freedesktop.login1.User", "Display")),
            None, Gio.DBusCallFlags.NONE, 2000, None
        )
        _sid, spath = prop.unpack()[0]
        if spath and spath != "/":
            return spath
    except Exception:
        pass

    slist = bus.call_sync(
        "org.freedesktop.login1", "/org/freedesktop/login1",
        "org.freedesktop.login1.Manager", "ListSessions",
        None, None, Gio.DBusCallFlags.NONE, 2000, None
    ).unpack()[0]
    for _id, s_uid, _name, seat, spath in slist:
        if s_uid == uid and seat:
            return spath
    for _id, s_uid, _name, _seat, spath in slist:
        if s_uid == uid:
            return spath
    raise RuntimeError("No active logind session found for user")


def run_daemon() -> None:
    runtime_dir = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
    lock_path = os.path.join(runtime_dir, "pop-lockscreen.lock")
    lock_fp = open(lock_path, "w")
    try:
        fcntl.flock(lock_fp.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        sys.exit(0)

    bus = Gio.bus_get_sync(Gio.BusType.SYSTEM, None)
    sess_path = resolve_session_path(bus)

    sleep_fd: int | None = None

    def take_sleep_inhibitor() -> None:
        nonlocal sleep_fd
        if sleep_fd is not None:
            return
        try:
            res, fd_list = bus.call_with_unix_fd_list_sync(
                "org.freedesktop.login1", "/org/freedesktop/login1",
                "org.freedesktop.login1.Manager", "Inhibit",
                GLib.Variant("(ssss)", ("sleep", "Pop Lockscreen", "Lock screen before sleep", "delay")),
                None, Gio.DBusCallFlags.NONE, 2000, None, None
            )
            if fd_list and fd_list.get_length() > 0:
                sleep_fd = fd_list.steal_fds()[0]
        except Exception:
            sleep_fd = None

    def release_sleep_inhibitor() -> None:
        nonlocal sleep_fd
        if sleep_fd is not None:
            try:
                os.close(sleep_fd)
            except OSError:
                pass
            sleep_fd = None

    def set_locked_hint(val: bool) -> None:
        try:
            bus.call_sync(
                "org.freedesktop.login1", sess_path,
                "org.freedesktop.login1.Session", "SetLockedHint",
                GLib.Variant("(b)", (val,)), None, Gio.DBusCallFlags.NONE, 1000, None
            )
        except Exception:
            pass

    ctrl = LockSessionController(
        on_locked_cb=lambda: GLib.idle_add(set_locked_hint, True),
        on_unlocked_cb=lambda: GLib.idle_add(set_locked_hint, False),
    )

    take_sleep_inhibitor()

    def on_session_signal(_conn, _sender, _path, _iface, sig_name, _params):
        if sig_name == "Lock":
            ctrl.start_lock()
        elif sig_name == "Unlock":
            ctrl.force_unlock()

    def on_prepare_sleep(_conn, _sender, _path, _iface, _sig_name, params):
        start = bool(params.unpack()[0])
        if start:
            ctrl.start_lock(wait_locked_s=1.5)
            release_sleep_inhibitor()
        else:
            take_sleep_inhibitor()

    bus.signal_subscribe(
        "org.freedesktop.login1", "org.freedesktop.login1.Session", "Lock",
        sess_path, None, Gio.DBusSignalFlags.NONE, on_session_signal
    )
    bus.signal_subscribe(
        "org.freedesktop.login1", "org.freedesktop.login1.Session", "Unlock",
        sess_path, None, Gio.DBusSignalFlags.NONE, on_session_signal
    )
    bus.signal_subscribe(
        "org.freedesktop.login1", "org.freedesktop.login1.Manager", "PrepareForSleep",
        "/org/freedesktop/login1", None, Gio.DBusSignalFlags.NONE, on_prepare_sleep
    )

    loop = GLib.MainLoop()

    def on_sigusr1(_signum, _frame):
        GLib.idle_add(ctrl.start_lock)

    def on_sigterm(_signum, _frame):
        ctrl.force_unlock()
        GLib.idle_add(loop.quit)

    signal.signal(signal.SIGUSR1, on_sigusr1)
    signal.signal(signal.SIGTERM, on_sigterm)
    signal.signal(signal.SIGINT, on_sigterm)

    try:
        loop.run()
    finally:
        release_sleep_inhibitor()


def make_preview(out_path: str) -> None:
    cfg = load_config()
    wp_cache = WallpaperCache()
    now = datetime.now()
    w, h = 1920, 1080
    raw = render_lockscreen_frame(
        w, h, cfg, wp_cache, now,
        password="", show_password=False, verifying=False,
        error_msg="", caps_lock=False, cursor_on=False, hover_target=None,
        wifi_info=(True, "Wi-Fi: Google-5G (82%)"), vol_info=(False, 100), active_popover=None,
    )
    arr = np.frombuffer(raw, dtype=np.uint8).reshape((h, w, 4))
    rgb = arr[:, :, [2, 1, 0]]
    Image.fromarray(rgb).save(out_path)
    print(f"Lockscreen preview saved to {out_path}")


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--preview":
        out = sys.argv[2] if len(sys.argv) > 2 else "/tmp/pop_lockscreen_preview.png"
        make_preview(out)
    elif len(sys.argv) > 1 and sys.argv[1] == "--lock-now":
        c = LockSessionController()
        c.start_lock()
        while c.is_active():
            time.sleep(0.2)
    else:
        run_daemon()
