        ctx.set_source_rgba(0.98, 0.96, 1.0, 0.96)
        ctx.arc(x + 17, y + 23, 8, 0, 2 * math.pi)
        ctx.arc(x + 27, y + 18, 10, 0, 2 * math.pi)
