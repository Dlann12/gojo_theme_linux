        "266": ("Gerimis", "rain"), "293": ("Hujan Ringan", "rain"),
        "296": ("Hujan Ringan", "rain"), "299": ("Hujan Sedang", "rain"),
        "302": ("Hujan Sedang", "rain"), "305": ("Hujan Deras", "rain"),
        "308": ("Hujan Deras", "rain"), "353": ("Hujan Ringan", "rain"),
        "356": ("Hujan Deras", "rain"), "359": ("Hujan Lebat", "rain"),
        "386": ("Badai Petir", "storm"), "389": ("Badai Petir", "storm"),
    }

    def __init__(self):
        self.data = {
            "temp": "--", "feels": "--", "humidity": "--", "wind": "--",
            "cond": "Memuat cuaca...", "icon": "cloud", "city": "Jakarta", "ver": 0,
        }
        self._load_cache()

    def _load_cache(self):
        try:
            if os.path.exists(WEATHER_CACHE_PATH):
                with open(WEATHER_CACHE_PATH, "r", encoding="utf-8") as f:
                    self.data.update(json.load(f))
        except Exception:
            pass

    def refresh_once(self):
        try:
            req = urllib.request.Request("https://wttr.in/?format=j1", headers={"User-Agent": "curl/8.0"})
            with urllib.request.urlopen(req, timeout=8) as r:
                raw = json.loads(r.read().decode("utf-8"))
            cc = raw["current_condition"][0]
            area = raw.get("nearest_area", [{}])[0]
            region = area.get("region", [{}])[0].get("value", "")
            city = area.get("areaName", [{}])[0].get("value", "Jakarta")
            city_disp = "Jakarta" if "jakarta" in region.lower() else (city or region or "Lokal")
            code = str(cc.get("weatherCode", "119"))
            cond_id, icon_kind = self.CODE_MAP.get(code, (cc.get("weatherDesc", [{}])[0].get("value", "Berawan"), "cloud"))
            self.data = {
                "temp": cc.get("temp_C", "--"),
                "feels": cc.get("FeelsLikeC", "--"),
                "humidity": cc.get("humidity", "--"),
                "wind": cc.get("windspeedKmph", "--"),
                "cond": cond_id,
                "icon": icon_kind,
                "city": city_disp,
                "ver": self.data.get("ver", 0) + 1,
            }
            with open(WEATHER_CACHE_PATH, "w", encoding="utf-8") as f:
                json.dump(self.data, f)
        except Exception:
            pass

    def start_loop(self):
        def worker():
            while True:
                self.refresh_once()
                time.sleep(900)
        threading.Thread(target=worker, daemon=True).start()


class MprisReader:
    def __init__(self):
        try:
            self._bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        except Exception:
            self._bus = None

    def read(self) -> dict | None:
        if not self._bus:
            return None
        try:
            res = self._bus.call_sync(
                "org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus",
                "ListNames", None, None, Gio.DBusCallFlags.NONE, 150, None
            )
            names = [n for n in res.unpack()[0] if n.startswith("org.mpris.MediaPlayer2.")]
            if not names:
                return None

            chosen = None
            for name in names:
                props = self._bus.call_sync(
                    name, "/org/mpris/MediaPlayer2", "org.freedesktop.DBus.Properties",
                    "GetAll", GLib.Variant("(s)", ("org.mpris.MediaPlayer2.Player",)),
                    None, Gio.DBusCallFlags.NONE, 150, None
                ).unpack()[0]
                status = props.get("PlaybackStatus", "Stopped")
                if status in ("Playing", "Paused"):
                    meta = props.get("Metadata", {})
                    title = meta.get("xesam:title") or ""
                    artists = meta.get("xesam:artist") or []
                    artist = ", ".join(artists) if isinstance(artists, (list, tuple)) else str(artists)
                    length_us = meta.get("mpris:length", 0) or 0
                    pos_us = props.get("Position", 0) or 0
                    player = name.split("org.mpris.MediaPlayer2.")[-1].split(".")[0].capitalize()
                    chosen = {
                        "player": player, "status": status,
                        "title": title or "Tanpa Judul", "artist": artist or player,
                        "pos_s": max(0, int(pos_us // 1_000_000)),
                        "len_s": max(0, int(length_us // 1_000_000)),
                    }
                    if status == "Playing":
                        return chosen
            return chosen
        except Exception:
            return None


def greeting_id(hour: int) -> str:
    if 4 <= hour < 11:
        return "Selamat Pagi"
    if 11 <= hour < 15:
        return "Selamat Siang"
    if 15 <= hour < 18:
        return "Selamat Sore"
    return "Selamat Malam"


def fmt_speed(bps: float) -> str:
    if bps >= 1024 * 1024:
        return f"{bps / (1024 * 1024):.1f} MB/s"
    if bps >= 1024:
        return f"{bps / 1024:.0f} KB/s"
    return f"{bps:.0f} B/s"


def draw_bar_track(ctx: cairo.Context, x: float, y: float, w: float, h: float, r: float) -> None:
    rounded_rect_path(ctx, x, y, w, h, r)
    ctx.set_source_rgba(0.04, 0.03, 0.10, 0.30)
    ctx.fill_preserve()
    ctx.set_source_rgba(1.0, 1.0, 1.0, 0.18)
    ctx.set_line_width(0.6)
    ctx.stroke()


