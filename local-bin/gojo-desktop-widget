        for i, v in enumerate(vals):
            px = spark_x + i * step
            py = spark_y + spark_h - 6 - (v / peak) * (spark_h - 14)
            ctx.line_to(px, py)
        ctx.line_to(spark_x + spark_w, spark_y + spark_h)
        ctx.close_path()
        ctx.set_source_rgba(col[0], col[1], col[2], fill_alpha)
        ctx.fill()

        ctx.new_path()
        for i, v in enumerate(vals):
            px = spark_x + i * step
            py = spark_y + spark_h - 6 - (v / peak) * (spark_h - 14)
            if i == 0:
                ctx.move_to(px, py)
            else:
                ctx.line_to(px, py)
        ctx.set_source_rgba(col[0], col[1], col[2], 0.95)
        ctx.set_line_width(1.8)
        ctx.stroke()
        ctx.restore()

    draw_spark(dl_vals, (0.38, 0.88, 1.0), 0.18)
    draw_spark(ul_vals, (0.98, 0.38, 0.90), 0.12)

    disk_x = pad3_x + 214
    disk_w = inner3_w - 214
    dbar_y = net_y + 52
    draw_bar_track(ctx, disk_x, dbar_y, disk_w, 7.0, 3.5)
    dfill_w = max(7.0, disk_w * min(1.0, disk_pct / 100.0))
    rounded_rect_path(ctx, disk_x, dbar_y, dfill_w, 7.0, 3.5)
    dg = cairo.LinearGradient(disk_x, dbar_y, disk_x + disk_w, dbar_y)
    dg.add_color_stop_rgba(0.0, 0.75, 0.42, 1.00, 0.95)
    dg.add_color_stop_rgba(1.0, 0.98, 0.32, 0.78, 0.98)
    ctx.set_source(dg)
    ctx.fill()

    text_ops.append((spark_x, net_y, f"↓ {fmt_speed(dl_bps)}", "DM Mono Medium 9", (0.58, 0.95, 1.0, 0.99), "left", -1, 0, False))
    text_ops.append((spark_x + 98, net_y, f"↑ {fmt_speed(ul_bps)}", "DM Mono Medium 9", (0.99, 0.64, 0.97, 0.98), "right", 100, 0, False))
    text_ops.append((spark_x, net_y + 19, "TRAFIK JARINGAN (30D)", "Fira Sans SemiBold 7", (0.90, 0.88, 1.0, 0.88), "left", -1, 700, False))

    text_ops.append((disk_x, net_y, "DISK /", "Fira Sans SemiBold 9", (0.92, 0.88, 1.0, 0.92), "left", -1, 800, False))
    text_ops.append((disk_x, net_y + 22, f"{disk_used:.0f}/{disk_total:.0f} GB", "DM Mono Medium 9.5", (0.99, 0.98, 1.0, 0.98), "left", -1, 0, False))
    text_ops.append((disk_x, dbar_y + 16, f"{disk_pct:.0f}% TERPAKAI", "DM Mono 8", (0.96, 0.84, 1.0, 0.92), "left", -1, 0, False))

    surface.flush()
    del ctx
    del surface

    raw_arr = (ctypes.c_uint8 * len(buf)).from_buffer(buf)
    c_surf = _libcairo.cairo_image_surface_create_for_data(raw_arr, 0, SURF_W, SURF_H, SURF_W * 4)
    c_ctx = _libcairo.cairo_create(c_surf)
    for x, y, txt, fnt, col, align, w_box, ls, ell in text_ops:
        draw_text(c_ctx, x, y, txt, fnt, col, align=align, width=w_box, letter_spacing=ls, ellipsize=ell)
    _libcairo.cairo_surface_flush(c_surf)
    _libcairo.cairo_destroy(c_ctx)
    _libcairo.cairo_surface_destroy(c_surf)
    return bytes(buf)


def _cairo_buf_to_pil(buf: bytes, w: int, h: int):
    arr = np.frombuffer(buf, dtype=np.uint8).reshape((h, w, 4)).copy()
    bgra = arr[:, :, [2, 1, 0, 3]]
    a = bgra[:, :, 3:4].astype(np.float32) / 255.0
    rgb = np.where(a > 0, np.clip(bgra[:, :, :3].astype(np.float32) / np.maximum(a, 1e-4), 0, 255), 0).astype(np.uint8)
    return Image.fromarray(np.concatenate([rgb, bgra[:, :, 3:4]], axis=2))


def make_preview(out_path: str) -> None:
    from PIL import ImageDraw
    import random
    backdrops = WallpaperBackdropCache()
    telemetry = TelemetryReader()
    telemetry.read_cpu_pct()
    telemetry.read_network()
    for _ in range(25):
        telemetry.dl_hist.append(random.uniform(40_000, 420_000))
        telemetry.ul_hist.append(random.uniform(10_000, 120_000))
    weather = WeatherFetcher()
    weather.refresh_once()
    mpris = MprisReader()
    time.sleep(0.15)
    now = datetime.now()

    wall = Image.open(backdrops.get_wallpaper_path()).convert("RGBA").resize((SCREEN_W, SCREEN_H), Image.LANCZOS)
    buf = render_centered_suite(bytearray(SURF_W * SURF_H * 4), telemetry, weather, mpris, now, backdrops)
    im = _cairo_buf_to_pil(buf, SURF_W, SURF_H)
    wall.paste(im, (POS_X, POS_Y), im)

    overlay = Image.new("RGBA", (SCREEN_W, SCREEN_H), (0, 0, 0, 0))
    od = ImageDraw.Draw(overlay)
    od.rectangle([0, 0, SCREEN_W, 32], fill=(16, 12, 32, 150))
    od.rounded_rectangle([4, 210, 62, 870], radius=16, fill=(16, 12, 32, 165), outline=(192, 107, 255, 70), width=1)
    wall = Image.alpha_composite(wall, overlay)
    wall.save(out_path)
    print(f"Centered bento preview saved to {out_path}")


def run_daemon() -> None:
    backdrops = WallpaperBackdropCache()
    telemetry = TelemetryReader()
    telemetry.read_cpu_pct()
    telemetry.read_network()
    weather = WeatherFetcher()
    weather.start_loop()
    mpris = MprisReader()

    frame_buf = bytearray(SURF_W * SURF_H * 4)
    proc = None
    running = True

    def stop_handler(_sig, _frame):
        nonlocal running
        running = False

    signal.signal(signal.SIGTERM, stop_handler)
    signal.signal(signal.SIGINT, stop_handler)

    try:
        while running:
            if proc is None or proc.poll() is not None:
                proc = subprocess.Popen(
                    [HOST_BIN, str(SURF_W), str(SURF_H), str(POS_Y), str(POS_X), "top-left"],
                    stdin=subprocess.PIPE,
                )

            now = datetime.now()
            frame = render_centered_suite(frame_buf, telemetry, weather, mpris, now, backdrops)
            try:
                proc.stdin.write(frame)
                proc.stdin.flush()
            except BrokenPipeError:
                proc = None
                time.sleep(0.5)
                continue

            now_t = time.time()
            sleep_s = 1.0 - (now_t % 1.0) + 0.015
            time.sleep(min(1.05, max(0.05, sleep_s)))
    finally:
        if proc is not None:
            try:
                if proc.stdin:
                    proc.stdin.close()
            except Exception:
                pass
            if proc.poll() is None:
                proc.terminate()
                try:
                    proc.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    proc.kill()


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "--preview":
        out = sys.argv[2] if len(sys.argv) > 2 else "/tmp/gojo_centered_preview.png"
        make_preview(out)
    else:
        run_daemon()
