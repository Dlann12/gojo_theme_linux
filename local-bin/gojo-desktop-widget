    if kind in ("partly", "cloud", "rain", "storm"):
        ctx.save()
        ctx.set_source_rgba(0.03, 0.02, 0.08, 0.38)
        ctx.arc(x + 17.8, y + 24.4, 8, 0, 2 * math.pi)
        ctx.arc(x + 27.8, y + 19.4, 10, 0, 2 * math.pi)
        ctx.arc(x + 35.8, y + 25.4, 7, 0, 2 * math.pi)
        ctx.rectangle(x + 17.8, y + 22.4, 18, 10)
