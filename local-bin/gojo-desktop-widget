def draw_text(
    c_ctx: int,
    x: float,
    y: float,
    text: str,
    font_desc: str,
    rgba: tuple[float, float, float, float],
    align: str = "left",
    width: float = -1,
    letter_spacing: int = 0,
    ellipsize: bool = False,
    shadow: bool = True,
) -> None:
    layout = _libpangocairo.pango_cairo_create_layout(c_ctx)
    desc = _libpango.pango_font_description_from_string(font_desc.encode("utf-8"))
    _libpango.pango_layout_set_font_description(layout, desc)
    _libpango.pango_font_description_free(desc)

    attrs = None
    if letter_spacing:
        attrs = _libpango.pango_attr_list_new()
        _libpango.pango_attr_list_insert(attrs, _libpango.pango_attr_letter_spacing_new(int(letter_spacing)))
        _libpango.pango_layout_set_attributes(layout, attrs)

    if width > 0:
        _libpango.pango_layout_set_width(layout, int(width * PANGO_SCALE))
        if ellipsize:
            _libpango.pango_layout_set_ellipsize(layout, PANGO_ELLIPSIZE_END)
    if align == "right":
        _libpango.pango_layout_set_alignment(layout, PANGO_ALIGN_RIGHT)
    elif align == "center":
        _libpango.pango_layout_set_alignment(layout, PANGO_ALIGN_CENTER)
    else:
        _libpango.pango_layout_set_alignment(layout, PANGO_ALIGN_LEFT)

    tb = text.encode("utf-8")
    _libpango.pango_layout_set_text(layout, tb, len(tb))

    if shadow and rgba[3] >= 0.35:
        a = float(rgba[3])
        halo_a = min(0.55, a * 0.38)
        drop_a = min(0.82, a * 0.68)
        for dx, dy, sa in (
            (-0.7, 0.0, halo_a),
            (0.7, 0.0, halo_a),
            (0.0, -0.6, halo_a * 0.85),
            (0.0, 1.3, drop_a),
            (0.8, 1.7, halo_a),
        ):
            _libcairo.cairo_set_source_rgba(c_ctx, 0.03, 0.02, 0.08, sa)
            _libcairo.cairo_move_to(c_ctx, float(x + dx), float(y + dy))
            _libpangocairo.pango_cairo_show_layout(c_ctx, layout)

    _libcairo.cairo_set_source_rgba(c_ctx, float(rgba[0]), float(rgba[1]), float(rgba[2]), float(rgba[3]))
    _libcairo.cairo_move_to(c_ctx, float(x), float(y))
    _libpangocairo.pango_cairo_show_layout(c_ctx, layout)

    if attrs:
        _libpango.pango_attr_list_unref(attrs)
    _libgobject.g_object_unref(layout)


def rounded_rect_path(ctx: cairo.Context, x: float, y: float, w: float, h: float, r: float) -> None:
    r = min(r, w / 2.0, h / 2.0)
    ctx.new_sub_path()
    ctx.arc(x + w - r, y + r, r, -math.pi / 2, 0)
    ctx.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
    ctx.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
    ctx.arc(x + r, y + r, r, math.pi, 3 * math.pi / 2)
    ctx.close_path()


class WallpaperBackdropCache:
    """Provides real-time frosted acrylic crops from the active COSMIC wallpaper."""

    def __init__(self):
        self._state_sig = None
        self._backdrop_surf = None
        self._backdrop_buf = None

    def get_wallpaper_path(self) -> str:
        try:
            if os.path.exists(BG_CONFIG_PATH):
                txt = open(BG_CONFIG_PATH, "r", encoding="utf-8").read()
                m = re.search(r'Path\("([^"]+)"\)', txt)
                if m and os.path.exists(m.group(1)):
                    return m.group(1)
        except Exception:
            pass
        return DEFAULT_WALLPAPER

    def get_surface(self) -> tuple[cairo.ImageSurface, bytearray] | None:
        wp = self.get_wallpaper_path()
        try:
            mtime = os.path.getmtime(wp)
        except OSError:
            mtime = 0
        sig = (wp, mtime)
        if sig == self._state_sig and self._backdrop_surf is not None:
            return (self._backdrop_surf, self._backdrop_buf)

        try:
            im = Image.open(wp).convert("RGB")
            iw, ih = im.size
            scale = max(SCREEN_W / iw, SCREEN_H / ih)
            nw, nh = int(round(iw * scale)), int(round(ih * scale))
            im = im.resize((nw, nh), Image.LANCZOS)
            left = (nw - SCREEN_W) // 2
            top = (nh - SCREEN_H) // 2
            im = im.crop((left, top, left + SCREEN_W, top + SCREEN_H))
            # Frosted acrylic blur + slight saturation lift + obsidian tint for crisp readability
            im = ImageEnhance.Color(im).enhance(1.16)
            im = im.filter(ImageFilter.GaussianBlur(radius=24))
            arr = np.array(im, dtype=np.float32)
            tint = np.array([10.0, 9.0, 24.0], dtype=np.float32)
            blended = np.clip(arr * 0.54 + tint * 0.46, 0, 255).astype(np.uint8)

            crop = blended[POS_Y:POS_Y + SURF_H, POS_X:POS_X + SURF_W]
            alpha = 232
            af = alpha / 255.0
            bgra = np.empty((SURF_H, SURF_W, 4), dtype=np.uint8)
            bgra[:, :, 0] = np.clip(crop[:, :, 2] * af, 0, 255).astype(np.uint8)
            bgra[:, :, 1] = np.clip(crop[:, :, 1] * af, 0, 255).astype(np.uint8)
            bgra[:, :, 2] = np.clip(crop[:, :, 0] * af, 0, 255).astype(np.uint8)
            bgra[:, :, 3] = alpha

            self._backdrop_buf = bytearray(bgra.tobytes())
            self._backdrop_surf = cairo.ImageSurface.create_for_data(
                self._backdrop_buf, cairo.FORMAT_ARGB32, SURF_W, SURF_H, SURF_W * 4
            )
            self._state_sig = sig
            return (self._backdrop_surf, self._backdrop_buf)
        except Exception:
            return None


def draw_glass_card(
    ctx: cairo.Context,
    cx: float,
    cy: float,
    cw: float,
    ch: float,
    cr: float,
    backdrop: tuple[cairo.ImageSurface, bytearray] | None,
) -> None:
    if CARD_BORDER_ALPHA > 0:
        rounded_rect_path(ctx, cx - 1, cy - 1, cw + 2, ch + 2, cr + 1)
        ctx.set_source_rgba(0.04, 0.02, 0.10, 0.18)
        ctx.set_line_width(3.0)
        ctx.stroke()

    if CARD_BG_ALPHA > 0:
        ctx.save()
        rounded_rect_path(ctx, cx, cy, cw, ch, cr)
        ctx.clip()
        if backdrop is not None:
            bg_surf, _ = backdrop
            ctx.set_source_surface(bg_surf, 0, 0)
            ctx.paint_with_alpha(CARD_BG_ALPHA)
        else:
            ctx.set_source_rgba(0.05, 0.04, 0.11, CARD_BG_ALPHA)
            ctx.paint()
        ctx.restore()

    if CARD_BORDER_ALPHA > 0:
        rounded_rect_path(ctx, cx, cy, cw, ch, cr)
        border_grad = cairo.LinearGradient(cx, cy, cx + cw, cy + ch)
        border_grad.add_color_stop_rgba(0.0, 1.00, 0.94, 1.00, CARD_BORDER_ALPHA)
        border_grad.add_color_stop_rgba(0.45, 0.86, 0.55, 0.99, CARD_BORDER_ALPHA * 0.72)
        border_grad.add_color_stop_rgba(1.0, 0.52, 0.88, 0.99, CARD_BORDER_ALPHA * 0.85)
        ctx.set_source(border_grad)
        ctx.set_line_width(1.2)
        ctx.stroke()


def draw_glow_dot(ctx: cairo.Context, x: float, y: float, rgb=(0.96, 0.42, 0.98)) -> None:
    halo = cairo.RadialGradient(x, y, 1, x, y, 10)
    halo.add_color_stop_rgba(0.0, rgb[0], rgb[1], rgb[2], 0.95)
    halo.add_color_stop_rgba(1.0, rgb[0], rgb[1], rgb[2], 0.0)
    ctx.set_source(halo)
    ctx.arc(x, y, 10, 0, 2 * math.pi)
    ctx.fill()
    ctx.set_source_rgba(1, 1, 1, 0.95)
    ctx.arc(x, y, 2.8, 0, 2 * math.pi)
    ctx.fill()


def draw_gradient_divider(ctx: cairo.Context, x0: float, x1: float, y: float) -> None:
    div_grad = cairo.LinearGradient(x0, y, x1, y)
    div_grad.add_color_stop_rgba(0.0, 1.0, 1.0, 1.0, 0.0)
    div_grad.add_color_stop_rgba(0.2, 0.92, 0.72, 1.0, 0.24)
    div_grad.add_color_stop_rgba(0.8, 0.55, 0.88, 1.0, 0.24)
    div_grad.add_color_stop_rgba(1.0, 1.0, 1.0, 1.0, 0.0)
    ctx.set_source(div_grad)
    ctx.set_line_width(1.0)
    ctx.move_to(x0, y)
    ctx.line_to(x1, y)
    ctx.stroke()


