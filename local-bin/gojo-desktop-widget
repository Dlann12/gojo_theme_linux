class TelemetryReader:
    def __init__(self):
        self._prev_total = None
        self._prev_idle = None
        self._prev_net = None
        self._prev_net_t = None
        self.dl_hist = deque([0.0] * 30, maxlen=30)
        self.ul_hist = deque([0.0] * 30, maxlen=30)

    def read_cpu_pct(self) -> float:
        try:
            with open("/proc/stat", "r", encoding="utf-8") as f:
                vals = [int(x) for x in f.readline().split()[1:9]]
            idle = vals[3] + vals[4]
            total = sum(vals)
            if self._prev_total is None:
                self._prev_total, self._prev_idle = total, idle
                return 0.0
            dt = total - self._prev_total
            di = idle - self._prev_idle
            self._prev_total, self._prev_idle = total, idle
            return 0.0 if dt <= 0 else max(0.0, min(100.0, 100.0 * (dt - di) / dt))
        except Exception:
            return 0.0

    def read_ram(self) -> tuple[float, float, float]:
        try:
            info = {}
            with open("/proc/meminfo", "r", encoding="utf-8") as f:
                for line in f:
                    k, v = line.split(":", 1)
                    info[k] = int(v.strip().split()[0])
            total_kb = info.get("MemTotal", 1)
            used_kb = max(0, total_kb - info.get("MemAvailable", 0))
            return used_kb / 1048576.0, total_kb / 1048576.0, 100.0 * used_kb / total_kb
        except Exception:
            return 0.0, 0.0, 0.0

    def read_battery_and_temp(self) -> tuple[int | None, str, int | None]:
        cap, status = None, ""
        try:
            for name in sorted(os.listdir("/sys/class/power_supply")):
                p = f"/sys/class/power_supply/{name}"
                tpath = f"{p}/type"
                if os.path.exists(tpath) and open(tpath).read().strip() == "Battery":
                    cap = int(open(f"{p}/capacity").read().strip())
                    status = open(f"{p}/status").read().strip()
                    break
        except Exception:
            pass
        temp_c = None
        try:
            for name in sorted(os.listdir("/sys/class/thermal")):
                if name.startswith("thermal_zone"):
                    t = int(open(f"/sys/class/thermal/{name}/temp").read().strip()) // 1000
                    if 15 <= t <= 115:
                        temp_c = t
                        break
        except Exception:
            pass
        return cap, status, temp_c

    def read_disk_root(self) -> tuple[float, float, float]:
        try:
            st = os.statvfs("/")
            total = (st.f_blocks * st.f_frsize) / (1024**3)
            used = ((st.f_blocks - st.f_bfree) * st.f_frsize) / (1024**3)
            avail = (st.f_bavail * st.f_frsize) / (1024**3)
            pct = 100.0 * used / max(used + avail, 1e-3)
            return used, total, pct
        except Exception:
            return 0.0, 0.0, 0.0

    def read_uptime_str(self) -> str:
        try:
            secs = int(float(open("/proc/uptime").read().split()[0]))
            h, rem = divmod(secs, 3600)
            m = rem // 60
            return f"{h}j {m:02d}m" if h > 0 else f"{m}m"
        except Exception:
            return "--"

    def read_network(self) -> tuple[str, bool, float, float]:
        iface, online = None, False
        try:
            for name in sorted(os.listdir("/sys/class/net")):
                if name == "lo" or name.startswith(("docker", "br-", "veth", "lxc", "waydroid", "virbr")):
                    continue
                state_p = f"/sys/class/net/{name}/operstate"
                st = open(state_p).read().strip() if os.path.exists(state_p) else "down"
                if st == "up":
                    iface = name
                    online = True
                    break
                if iface is None:
                    iface = name
        except Exception:
            pass

        if not iface:
            return "offline", False, 0.0, 0.0

        now_t = time.monotonic()
        try:
            rx = int(open(f"/sys/class/net/{iface}/statistics/rx_bytes").read().strip())
            tx = int(open(f"/sys/class/net/{iface}/statistics/tx_bytes").read().strip())
        except Exception:
            return iface, online, 0.0, 0.0

        if self._prev_net is None or self._prev_net_t is None:
            self._prev_net = (rx, tx)
            self._prev_net_t = now_t
            return iface, online, 0.0, 0.0

        dt = max(0.05, now_t - self._prev_net_t)
        dl_bps = max(0.0, (rx - self._prev_net[0]) / dt)
        ul_bps = max(0.0, (tx - self._prev_net[1]) / dt)
        self._prev_net = (rx, tx)
        self._prev_net_t = now_t
        self.dl_hist.append(dl_bps)
        self.ul_hist.append(ul_bps)
        return iface, online, dl_bps, ul_bps


