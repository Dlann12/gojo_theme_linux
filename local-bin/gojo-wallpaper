#!/usr/bin/env bash
set -euo pipefail

SERVICE="gojo-live-wallpaper.service"
ENV_FILE="$HOME/.config/gojo-live-wallpaper.env"
COSMIC_BG="$HOME/.config/cosmic/com.system76.CosmicBackground/v1/all"

DEFAULT_IMAGE="/home/kerja/Downloads/satoru-gojo-jujutsu-3840x2160-9292.jpg"
DEFAULT_THEME="jujutsu"
DEFAULT_FPS="28"
DEFAULT_BRIGHTNESS="0.62"
DEFAULT_LAYER="bottom"

ensure_env() {
  if [[ ! -f "$ENV_FILE" ]]; then
    mkdir -p "$(dirname "$ENV_FILE")"
    cat > "$ENV_FILE" <<EOF
GOJO_IMAGE=$DEFAULT_IMAGE
GOJO_THEME=$DEFAULT_THEME
GOJO_FPS=$DEFAULT_FPS
GOJO_BRIGHTNESS=$DEFAULT_BRIGHTNESS
GOJO_LAYER=$DEFAULT_LAYER
EOF
  fi
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  GOJO_BRIGHTNESS="${GOJO_BRIGHTNESS:-$DEFAULT_BRIGHTNESS}"
}

write_env() {
  cat > "$ENV_FILE" <<EOF
GOJO_IMAGE=$GOJO_IMAGE
GOJO_THEME=$GOJO_THEME
GOJO_FPS=$GOJO_FPS
GOJO_BRIGHTNESS=$GOJO_BRIGHTNESS
GOJO_LAYER=$GOJO_LAYER
EOF
}

update_cosmic_bg() {
  local img="$1"
  if [[ -f "$COSMIC_BG" ]]; then
    python3 - "$COSMIC_BG" "$img" <<'PY'
import re, sys
cfg, img = sys.argv[1], sys.argv[2]
txt = open(cfg, "r", encoding="utf-8").read()
new_txt = re.sub(r'source:\s*Path\("[^"]+"\)', f'source: Path("{img}")', txt)
if new_txt != txt:
    open(cfg, "w", encoding="utf-8").write(new_txt)
PY
  fi
}

cmd="${1:-help}"
ensure_env

case "$cmd" in
  start)
    systemctl --user daemon-reload
    systemctl --user start "$SERVICE"
    ;;
  stop)
    systemctl --user stop "$SERVICE"
    ;;
  restart)
    systemctl --user daemon-reload
    systemctl --user restart "$SERVICE"
    ;;
  status)
    systemctl --user status "$SERVICE" --no-pager
    ;;
  enable)
    systemctl --user enable "$SERVICE"
    mkdir -p "$HOME/.config/autostart"
    cat > "$HOME/.config/autostart/gojo-live-wallpaper.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Gojo Live Wallpaper
Comment=GPU-accelerated Gojo Satoru Live Wallpaper
Exec=systemctl --user start gojo-live-wallpaper.service
Terminal=false
NoDisplay=true
X-GNOME-Autostart-enabled=true
X-COSMIC-Autostart-enabled=true
Hidden=false
EOF
    echo "Autostart Gojo Live Wallpaper diaktifkan."
    ;;
  disable)
    systemctl --user disable "$SERVICE"
    rm -f "$HOME/.config/autostart/gojo-live-wallpaper.desktop"
    echo "Autostart Gojo Live Wallpaper dimatikan."
    ;;
  preset)
    preset="${2:-}"
    case "$preset" in
      jujutsu)
        GOJO_IMAGE="/home/kerja/Downloads/satoru-gojo-jujutsu-3840x2160-9292.jpg"
        GOJO_THEME="jujutsu"
        ;;
      hollow)
        GOJO_IMAGE="/home/kerja/Pictures/Wallpapers/gojo-hollow-purple.jpg"
        GOJO_THEME="hollow"
        ;;
      amoled)
        GOJO_IMAGE="/home/kerja/Downloads/satoru-gojo-amoled-3840x2160-16769.jpg"
        GOJO_THEME="amoled"
        ;;
      redblue)
        GOJO_IMAGE="/home/kerja/Downloads/satoru-gojo-jjk-3840x2160-19527.png"
        GOJO_THEME="redblue"
        ;;
      *)
        echo "Preset tersedia: jujutsu | hollow | amoled | redblue" >&2
        exit 1
        ;;
    esac
    write_env
    update_cosmic_bg "$GOJO_IMAGE"
    systemctl --user daemon-reload
    systemctl --user restart "$SERVICE"
    echo "Live wallpaper Gojo diganti ke preset: $preset"
    ;;
  image)
    img="${2:-}"
    theme="${3:-$GOJO_THEME}"
    if [[ -z "$img" || ! -f "$img" ]]; then
      echo "File gambar tidak ditemukan: $img" >&2
      exit 1
    fi
    GOJO_IMAGE="$(realpath "$img")"
    GOJO_THEME="$theme"
    write_env
    update_cosmic_bg "$GOJO_IMAGE"
    systemctl --user daemon-reload
    systemctl --user restart "$SERVICE"
    echo "Live wallpaper diganti ke: $GOJO_IMAGE (tema: $GOJO_THEME)"
    ;;
  fps)
    fps="${2:-28}"
    if ! [[ "$fps" =~ ^[0-9]+$ ]] || (( fps < 5 || fps > 60 )); then
      echo "FPS harus angka antara 5 dan 60" >&2
      exit 1
    fi
    GOJO_FPS="$fps"
    write_env
    systemctl --user restart "$SERVICE"
    echo "Target FPS live wallpaper disetel ke: $GOJO_FPS"
    ;;
  brightness)
    br="${2:-0.62}"
    if ! python3 -c "import sys; v=float(sys.argv[1]); assert 0.2 <= v <= 1.2" "$br" 2>/dev/null; then
      echo "Brightness harus angka antara 0.20 dan 1.20 (contoh: 0.55)" >&2
      exit 1
    fi
    GOJO_BRIGHTNESS="$br"
    write_env
    systemctl --user restart "$SERVICE"
    echo "Brightness live wallpaper disetel ke: $GOJO_BRIGHTNESS"
    ;;
  *)
    cat <<EOF
Pemakaian: gojo-wallpaper <perintah>
  start | stop | restart | status
  enable | disable
  preset <jujutsu|hollow|amoled|redblue>
  image <path> [jujutsu|hollow|amoled|redblue]
  fps <5-60>
  brightness <0.20-1.20>
EOF
    ;;
esac
