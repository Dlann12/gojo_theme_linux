[Unit]
Description=Hollow Purple Live Neon Audio Visualizer (Wayland Layer-Shell)
After=graphical-session.target cosmic-session.service pipewire-pulse.service
PartOf=graphical-session.target

[Service]
Type=simple
Environment=GDK_BACKEND=wayland
ExecStart=/usr/bin/python3 %h/.local/bin/hollow-viz daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
