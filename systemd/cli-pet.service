[Unit]
Description=Gojo 3D Terminal Overlay Pet
After=graphical-session.target cosmic-session.service
PartOf=graphical-session.target

[Service]
Type=simple
Environment=GDK_BACKEND=wayland
ExecStart=/usr/bin/python3 %h/.local/bin/pet-overlay
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
