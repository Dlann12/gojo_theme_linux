{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "small",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 3
    },
    "color": {
      "1": "38;2;192;132;252",
      "2": "38;2;56;189;248"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;192;132;252",
      "title": "38;2;56;189;248"
    },
    "bar": {
      "char": {
        "elapsed": "█",
        "total": "░"
      },
      "width": 10
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}@{host-name-colored}"
    },
    {
      "type": "separator",
      "string": "──────────────────────────────"
    },
    {
      "type": "os",
      "key": "OS    "
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "de",
      "key": "DE    "
    },
    {
      "type": "shell",
      "key": "Shell "
    },
    {
      "type": "cpu",
      "key": "CPU   ",
      "format": "{name}"
    },
    {
      "type": "memory",
      "key": "RAM   ",
      "format": "{used} / {total} ({percentage})"
    },
    {
      "type": "disk",
      "key": "Disk  ",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
